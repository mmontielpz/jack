#!/usr/bin/env python3
"""Fixed-operation helper for temporary virbr0 UFW allow/cleanup under JACK-VM-GRANT-001."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from vm_grant import GrantContext, GrantError, load_json_set, verify_grant

FIXED_VM_NAME = "jack-win11-dogfood"
FIXED_VM_UUID = "16fa6324-af26-4145-90b9-c1c8f3ac9f1f"

UFW_ALLOW_CMD = [
    "ufw",
    "allow",
    "in",
    "on",
    "virbr0",
    "from",
    "192.168.122.10",
    "to",
    "192.168.122.1",
    "port",
    "1024:65535",
    "proto",
    "tcp",
    "comment",
    "temp-jack-ep005-dogfood",
]

UFW_DELETE_CMD = [
    "ufw",
    "delete",
    "allow",
    "in",
    "on",
    "virbr0",
    "from",
    "192.168.122.10",
    "to",
    "192.168.122.1",
    "port",
    "1024:65535",
    "proto",
    "tcp",
]


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="JACK-VM-GRANT-001 fixed virbr0 UFW helper")
    parser.add_argument(
        "--action",
        required=True,
        choices=["allow-ephemeral-virbr0", "cleanup-ephemeral-virbr0"],
    )
    parser.add_argument("--grant", required=True, help="Path to signed JACK-VM-GRANT-001 JSON")
    parser.add_argument("--dry-run", action="store_true", help="Validate grant and print fixed argv without invoking ufw")
    args = parser.parse_args(argv)

    key_file = Path(os.environ.get("JACK_GRANT_KEY_FILE", "/etc/jack-dogfood/grant.key"))
    revoked_file = Path(os.environ.get("JACK_GRANT_REVOKED_FILE", "/etc/jack-dogfood/revoked.json"))
    nonces_file = Path(os.environ.get("JACK_GRANT_NONCES_FILE", "/run/jack-dogfood/used_nonces.json"))
    audit_file = Path(os.environ.get("JACK_GRANT_AUDIT_FILE", "/var/log/jack-dogfood-grant.jsonl"))

    if not key_file.exists():
        print(f"ERR_GRANT_KEY_MISSING: {key_file}", file=sys.stderr)
        return 2

    secret_key = key_file.read_text(encoding="utf-8").strip().encode("utf-8")
    grant = json.loads(Path(args.grant).read_text(encoding="utf-8"))
    revoked_ids = load_json_set(revoked_file)

    op = "fw.virbr0.ephemeral.allow" if args.action == "allow-ephemeral-virbr0" else "fw.virbr0.ephemeral.cleanup"
    # Cleanup must remain idempotent even if allow already consumed the grant's nonce.
    consume_nonce = args.action == "allow-ephemeral-virbr0"

    try:
        verify_grant(
            grant,
            GrantContext(vm_name=FIXED_VM_NAME, vm_uuid=FIXED_VM_UUID, operation=op),
            secret_key=secret_key,
            revoked_ids=revoked_ids,
            used_nonces_file=nonces_file if consume_nonce else None,
            audit_path=audit_file,
            consume_nonce=consume_nonce,
        )
    except GrantError as exc:
        print(f"DENIED: {exc}", file=sys.stderr)
        return 1

    cmd = UFW_ALLOW_CMD if args.action == "allow-ephemeral-virbr0" else UFW_DELETE_CMD
    if args.dry_run:
        print("DRY_RUN:", " ".join(cmd))
        return 0

    proc = subprocess.run(cmd, shell=False, check=False, text=True, capture_output=True)
    if proc.stdout:
        print(proc.stdout.strip())
    if proc.returncode != 0:
        if proc.stderr:
            print(proc.stderr.strip(), file=sys.stderr)
        return proc.returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
